<Project>
  <!-- Valheim 1.0 port: one place for machine paths. Override with -p:ValheimDir=... or an env var. -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">D:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExCore>$(ValheimDir)\BepInEx\core</BepInExCore>
    <!-- Keep the builder's local folders (and user name) out of the dlls' debug info: source paths become /_/... -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
