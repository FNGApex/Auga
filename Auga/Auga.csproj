<Project Sdk="Microsoft.NET.Sdk">
  <!-- Valheim 1.0 port: SDK-style replacement of the VS2017 project (see git history for the original).
       The API stub is its own project (..\AugaAPI). ILRepack / APIManager.dll / API.External.cs / the pre-1.0
       Settings_Setup.cs and InventoryGrid_Patches.cs were removed on 2026-09-21 (dead since the port). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0169;CS0108;CS0114;CS0436;MSB3277</NoWarn>    <!-- Harmony's List<Label> doesn't resolve through the netstandard2.1 facades, so the plugin compiles against
         the BCL the game actually ships (Unity's Mono profile) instead of a reference pack. -->
    <TargetFramework>net48</TargetFramework>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AssemblyName>Auga</AssemblyName>
    <RootNamespace>Auga</RootNamespace>
    <PluginsDir>$(ValheimDir)\BepInEx\plugins\Auga</PluginsDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Publicized at build time; replaces the hand-made *_publicized.dll copies. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Publicize="true" Private="false" />
    <!-- 1.0: ui_lib.dll is gone, the Gui* widgets live here (namespace GUIFramework). -->
    <Reference Include="gui_framework" HintPath="$(ManagedDir)\gui_framework.dll" Publicize="true" Private="false" />
    <Reference Include="Splatform" HintPath="$(ManagedDir)\Splatform.dll" Private="false" />
    <Reference Include="SoftReferenceableAssets" HintPath="$(ManagedDir)\SoftReferenceableAssets.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(ManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
  </ItemGroup>  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(ManagedDir)\mscorlib.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(ManagedDir)\netstandard.dll" Private="false" />
    <Reference Include="System" HintPath="$(ManagedDir)\System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(ManagedDir)\System.Core.dll" Private="false" />
    <!-- netstandard2.1 library from a net48-labelled project: build it first, reference the dll. -->
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Reference Include="Unity.Auga" HintPath="..\AugaUnityLib\bin\$(Configuration)\Unity.Auga.dll" Private="false" />
    <Reference Include="fastJSON" HintPath="..\Libs\fastJSON.dll" Private="false" />
    <!-- Loaded from the plugin's own resources at startup (Auga.LoadDependencies / LoadAssetBundle). -->
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets" LogicalName="Auga.augaassets" />
    <EmbeddedResource Include="..\Libs\fastJSON.dll" LogicalName="Auga.fastJSON.dll" />
    <EmbeddedResource Include="..\AugaUnityLib\bin\$(Configuration)\Unity.Auga.dll" LogicalName="Auga.Unity.Auga.dll" />
  </ItemGroup>
  <Target Name="DeployToValheim" AfterTargets="Build" Condition="'$(DeployAuga)' == 'true' And Exists('$(ValheimDir)\BepInEx')">
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(TargetPath);translations.json" DestinationFolder="$(PluginsDir)" />
    <Message Importance="high" Text="Deployed Auga.dll -> $(PluginsDir)" />
  </Target>
</Project>
